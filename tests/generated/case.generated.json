{
  "name": "Login y selección de sede con pantallazo del logo",
  "url": "https://sistemasintegrales.sgmsalud.com.co/",
  "steps": [
    {
      "waitUntil": "load",
      "timeoutMs": 60000,
      "type": "goto"
    },
    {
      "timeoutMs": 30000,
      "type": "waitForSelector",
      "selector": "#password",
      "frame": "#iframeLogin"
    },
    {
      "timeoutMs": 30000,
      "type": "fill",
      "selector": "#username",
      "value": "frente",
      "frame": "#iframeLogin"
    },
    {
      "timeoutMs": 30000,
      "type": "fill",
      "selector": "#password",
      "value": "TecINsgm2026*",
      "frame": "#iframeLogin"
    },
    {
      "timeoutMs": 30000,
      "type": "click",
      "selector": "button.btn-login",
      "frame": "#iframeLogin"
    },
    {
      "timeoutMs": 30000,
      "type": "getFrameUrl",
      "frame": "main_window",
      "frameName": "main_window",
      "saveAs": "mainUrl"
    },
    {
      "timeoutMs": 30000,
      "type": "waitForSelector",
      "selector": "img[alt='SGM Salud']"
    },
    {
      "timeoutMs": 30000,
      "type": "screenshotSelector",
      "selector": "img[alt='SGM Salud']",
      "name": "Logo SGM Salud"
    },
    {
      "timeoutMs": 30000,
      "type": "click",
      "selector": "button[title='Escoger sede']"
    }
  ]
}