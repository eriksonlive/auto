{
  "name": "Login + sede + guardar + Consultar cliente",
  "url": "https://sistemasintegrales.sgmsalud.com.co/",
  "steps": [
    {
      "type": "goto",
      "waitUntil": "load",
      "timeoutMs": 60000
    },
    {
      "type": "waitForSelector",
      "selector": "#password",
      "frame": "#iframeLogin",
      "timeoutMs": 30000
    },
    {
      "type": "fill",
      "selector": "#username",
      "value": "frente",
      "frame": "#iframeLogin",
      "timeoutMs": 30000
    },
    {
      "type": "fill",
      "selector": "#password",
      "value": "TecINsgm2026*",
      "frame": "#iframeLogin",
      "timeoutMs": 30000
    },
    {
      "type": "click",
      "selector": "button.btn-login",
      "frame": "#iframeLogin",
      "timeoutMs": 30000
    },
    {
      "type": "wait",
      "ms": 3000
    },
    {
      "type": "getFrameUrl",
      "frame": "#iframeLogin",
      "frameName": "main_window",
      "saveAs": "mainUrl",
      "timeoutMs": 45000
    },
    {
      "type": "gotoFromOutput",
      "key": "mainUrl",
      "waitUntil": "load",
      "timeoutMs": 60000
    },
    {
      "type": "waitForSelector",
      "selector": "#department",
      "timeoutMs": 60000
    },
    {
      "type": "select",
      "selector": "#department",
      "text": "SISTEMAS INTEGRALES EN SALUD OCUPACIONAL IPS",
      "timeoutMs": 30000
    },
    {
      "type": "waitForOptions",
      "selector": "#position",
      "min": 1,
      "timeoutMs": 30000
    },
    {
      "type": "select",
      "selector": "#position",
      "text": "1",
      "timeoutMs": 30000
    },
    {
      "type": "click",
      "selector": "#saveDepartment",
      "timeoutMs": 30000
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "gotoMenuRouteFromMainUrl",
      "fromKey": "mainUrl",
      "action": "listado_clientes",
      "level": "Financiero--Clientes--Listado de clientes",
      "saveAs": "clientesUrl",
      "waitUntil": "domcontentloaded",
      "timeoutMs": 60000,
      "waitMs": 2500
    },
    {
      "type": "waitForSelector",
      "selector": "table",
      "timeoutMs": 60000
    },
    {
      "type": "screenshotSelector",
      "selector": "table",
      "name": "lista-medicos"
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "waitForSelector",
      "selector": "input[aria-label=\"filter data by RAZÓN SOCIAL\"]",
      "timeoutMs": 30000
    },
    {
      "type": "fill",
      "selector": "input[aria-label=\"filter data by RAZÓN SOCIAL\"]",
      "value": "prueba",
      "timeoutMs": 30000
    },
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "clickLinkInRow",
      "rowText": "EMPRESA PRUEBAS SGM",
      "linkAriaLabel": "Editar",
      "timeoutMs": 30000
    },
    {
      "type": "wait",
      "ms": 1500
    }
  ]
}